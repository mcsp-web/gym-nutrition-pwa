# Front end (Vite). Copy to .env.local for local dev; set the same names in Vercel/Coolify.
# "mock" = runs fully in the browser with seeded test users (no Supabase needed).
# "supabase" = real accounts, Postgres + RLS, Edge Function AI.
VITE_DATA_MODE=mock

# Only needed when VITE_DATA_MODE=supabase.
# The anon key is public by design; row-level security is what protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side only. NEVER put these in a VITE_ variable or the front end. ---
# Set with: supabase secrets set NAME=value
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# AI_DAILY_LIMIT_PER_MEMBER=3
# AI_DAILY_LIMIT_GLOBAL=100
# ALLOWED_ORIGIN=https://your-demo-domain
